COMPOSE_PROJECT_NAME=eegfaktura-docker-compose
WEB_URL=https://eeg.example.org
ADMIN_URL=https://admin-eeg.example.org
KEYCLOAK_URL=https://auth-eeg.example.org
PROXY_BIND_IP=127.0.0.1
TLS_CERT_FILE=/etc/ssl/eeg/fullchain.pem
TLS_KEY_FILE=/etc/ssl/eeg/privkey.pem
JWT_PUBLIC_KEY_FILE=/etc/eegfaktura/jwt-public-key.pem
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_TLS=yes
SMTP_USER=eeg@example.org
SMTP_EMAIL=eeg@example.org
SMTP_DOMAIN=example.org
SMTP_PASSWORD_FILE=/etc/eegfaktura/smtp-password
# Existing installation: supply existing DATABASE_PASSWORD, KEYCLOAK_DB_PASSWORD,
# POSTGRES_PASSWORD, KEYCLOAK_ADMIN_PASSWORD and KEYCLOAK_ADMIN_CLI_SECRET.
